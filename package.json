{
  "name": "ewm-keep-practicing",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "predev": "node scripts/auto-sync-pull.mjs",
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "preview:mobile": "node scripts/preview-mobile.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "cap:doctor": "node --experimental-strip-types ./node_modules/@capacitor/cli/bin/capacitor doctor",
    "cap:copy": "node --experimental-strip-types ./node_modules/@capacitor/cli/bin/capacitor copy",
    "cap:sync": "node --experimental-strip-types ./node_modules/@capacitor/cli/bin/capacitor sync",
    "cap:add:android": "node --experimental-strip-types ./node_modules/@capacitor/cli/bin/capacitor add android",
    "cap:add:ios": "node --experimental-strip-types ./node_modules/@capacitor/cli/bin/capacitor add ios",
    "cap:open:android": "node --experimental-strip-types ./node_modules/@capacitor/cli/bin/capacitor open android",
    "cap:open:ios": "node --experimental-strip-types ./node_modules/@capacitor/cli/bin/capacitor open ios"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^3.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.14.0",
    "express": "^4.21.2",
    "firebase": "^13.2.0",
    "idb": "^8.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.0.0",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
